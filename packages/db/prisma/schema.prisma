generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  CUSTOMER
}

model User {
  id               String   @id
  email            String?  @unique
  phone            String?  @unique
  fullName         String?
  role             Role     @default(CUSTOMER)
  stripeCustomerId String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}
